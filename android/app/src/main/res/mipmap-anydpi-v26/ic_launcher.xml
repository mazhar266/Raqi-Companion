<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon, used from Android 8 (API 26). Below that the launcher falls
     back to the full-bleed mipmap-*/ic_launcher.png. Regenerate both with the
     script described in AGENTS.md after replacing icon/icon.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- No <monochrome>: Android tints that layer by its alpha alone, and this
         foreground is a near-solid square, so a themed icon would come out as
         a blob. Without it, Android 13+ falls back to the icon above. -->
</adaptive-icon>
